{
  "name": "@askif/vercel",
  "version": "0.1.0",
  "description": "The Vercel AI Gateway Decision API backend for askif, with a ready-to-use `ask`.",
  "keywords": [
    "askif",
    "vercel",
    "ai-gateway",
    "decision",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asakaxgit/askif.git",
    "directory": "packages/vercel"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "example": "tsx examples/basic.ts"
  },
  "dependencies": {
    "askif": "^0.2.0"
  },
  "peerDependencies": {
    "ai": ">=7.0.128"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "ai": "^7.0.153",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.1.8"
  }
}
