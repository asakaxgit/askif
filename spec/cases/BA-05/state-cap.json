      {
        "answers": {
          "each": {
            "kind": "yesno",
            "probability": 0.5
          }
        }
      }
    ],
    "decide": [
      {
        "answers": {
          "each": {
            "kind": "yesno",
            "probability": 0.5
          }
        }
      }
    ]
  },
  "calls": [
    {
      "group": 0,
      "op": "is",
      "state": "a",
      "condition": "ok"
    },
    {
      "group": 0,
      "op": "is",
      "state": "b",
      "condition": "ok"
    },
    {
      "group": 0,
      "op": "is",
      "state": "c",
      "condition": "ok"
    }
  ],
  "expect": {
    "backendCalls": 2,
    "decideMany": [
      {
        "items": [
          {
            "state": "a"
          },
          {
            "state": "b"
          }
        ]
      }
    ],
    "decide": [
      {
        "state": "c",
        "questionCount": 1
      }
    ]
  }
}
