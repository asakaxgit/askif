{
  "id": "BA-05/state-cap",
  "criteria": [
    "BA-05"
  ],
  "tags": [
    "core"
  ],
  "config": {
    "maxStatesPerBatch": 2
  },
  "backend": {
    "multiState": true,
    "hasDecideMany": true
