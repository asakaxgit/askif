# Copy to .env.local and fill in what you need. Never commit .env.local.
# Only the key for the backend you actually call is required; the rest are
# optional and used by examples/backends.ts (which runs fine without them).

# @askif/jev (TypeSafe's Jev)
TYPESAFE_API_KEY=

# @askif/openai
OPENAI_API_KEY=

# @askif/clef (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenJev, a Jev-compatible server (used with @askif/jev). Codiv: https://api.codiv.ai
OPENJEV_API_KEY=
OPENJEV_BASE_URL=

# @askif/openai, other endpoints
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Vertex AI: a short-lived token, e.g. from `gcloud auth print-access-token`
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
# Amazon Bedrock
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
